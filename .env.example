# Local dev: copy to .env.local. The app calls the Vite dev server, which forwards to the backends
# (see devGateway in vite.config.ts) - no nginx, no CORS setup needed.
VITE_API_URL=/api
VITE_WS_URL=/ws

# Where the dev server forwards each module (defaults shown). Run app-core + your own app;
# a module that is not running just shows "Dịch vụ … chưa sẵn sàng" on its pages.
CORE_URL=http://localhost:8080
CRM_URL=http://localhost:8081
STATS_URL=http://localhost:8082
PROMOTIONS_URL=http://localhost:8083

# Production builds (Render) set VITE_API_URL / VITE_WS_URL to the nginx-gateway instead, e.g.
#   VITE_API_URL=https://<nginx-gateway>.onrender.com/api
#   VITE_WS_URL=https://<nginx-gateway>.onrender.com/ws
