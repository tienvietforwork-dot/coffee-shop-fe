# Base URL of the coffee-shop-be REST API (include the /api prefix)
VITE_API_URL=http://localhost:8081/api

# CRM backend: local app-crm service; for the gateway use its /api/crm/v1 URL
VITE_CRM_API_URL=http://localhost:8080/api/v1

# STOMP/WebSocket endpoint exposed by the backend (SockJS endpoint, no /api prefix)
VITE_WS_URL=http://localhost:8081/ws
